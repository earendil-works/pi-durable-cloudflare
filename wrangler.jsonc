{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pi-durable-cloudflare-do",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "Session",
      },
    ],
  },
  "exports": {
    "Session": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
  },
}
