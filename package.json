{
  "name": "pi-durable-cloudflare",
  "version": "0.87.1",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark": "vitest bench --run --config vitest.benchmark.config.ts",
    "build": "pnpm clean && vite build",
    "clean": "shx rm -rf .wrangler dist",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt --check . && wrangler types --env-file .dev.vars.example --include-runtime false --check && tsc && tsc -p tsconfig.client.json && pnpm build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest --run"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "partyserver": "0.5.10",
    "partysocket": "1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@cloudflare/vitest-plugin": "1.4.1",
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "0.73.0",
    "shx": "0.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  },
  "packageManager": "pnpm@11.15.1"
}
