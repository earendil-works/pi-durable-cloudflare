{
  "name": "pi-durable-cloudflare",
  "version": "0.87.1",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark": "vitest bench --run --config vitest.benchmark.config.ts",
    "clean": "shx rm -rf .wrangler",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt --check . && wrangler types --env-file .dev.vars.example --include-runtime false --check && tsc && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "wrangler dev",
    "test": "vitest --run"
  },
  "dependencies": {
    "@earendil-works/chord": "link:../../.herdr/worktrees/pi/dev-log/packages/chord",
    "@earendil-works/pi-ai": "link:../../.herdr/worktrees/pi/dev-log/packages/ai",
    "@earendil-works/pi-durable": "link:../../.herdr/worktrees/pi/dev-log/packages/durable"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.3",
    "@cloudflare/workers-types": "5.20260922.1",
    "oxfmt": "0.70.0",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "wrangler": "4.136.3"
  },
  "packageManager": "pnpm@11.15.1"
}
